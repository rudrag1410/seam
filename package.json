{
  "name": "seam",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "turbo run generate --filter=@seam/api-client",
    "db:migrate": "pnpm --filter @seam/backend db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
