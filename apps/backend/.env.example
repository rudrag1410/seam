APP_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# SQLite works out of the box. For Postgres:
#   postgresql+asyncpg://user:pass@host:5432/seam   (then run `pnpm db:migrate`)
DATABASE_URL=sqlite+aiosqlite:///./data/seam.db

JWT_SECRET=change-me
FIELD_ENCRYPTION_KEY=change-me-too
# Production across different domains needs: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# "live" calls OpenAI (and Jev when a key is set). "mock" is a deterministic offline stand-in
# for tests and keyless demos.
AI_MODE=live
OPENAI_API_KEY=
# Model ids are config, not code. Pin to whatever is current for your account.
LLM_MODEL_OPENAI_FAST=gpt-5-mini
LLM_MODEL_OPENAI_STRONG=gpt-5
LLM_MODEL_OPENAI_VISION=gpt-5-mini
PROMPT_VERSION=v1

# Caps on what goes into and comes out of the models. Tokens are estimated at ~4 characters.
# Hard ceiling on output per call (each task also has a smaller built-in budget):
LLM_MAX_OUTPUT_TOKENS=6000
# Longer job descriptions are rejected with a clear message:
LLM_MAX_JD_TOKENS=4000
# Resume text sent to a model is clipped to this:
LLM_MAX_RESUME_TOKENS=8000
# How hard reasoning models (gpt-5, o-series) think before answering. Lower is much faster.
# Leave empty if you use a non-reasoning model.
LLM_REASONING_EFFORT=low

# Optional. Without it every decision falls back to deterministic code ("basic mode").
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_CONFIDENCE_HIGH=0.80
JEV_CONFIDENCE_LOW=0.50

# Object storage. Leave R2_ENDPOINT empty to use local disk.
LOCAL_STORAGE_DIR=./data/files
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seam
SIGNED_URL_TTL_SECONDS=300

MAX_UPLOAD_MB=5
MAX_PAGES=6
