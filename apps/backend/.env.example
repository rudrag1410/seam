APP_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./data/seam.db

JWT_SECRET=change-me
FIELD_ENCRYPTION_KEY=change-me-too
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AI_MODE=mock
OPENAI_API_KEY=
LLM_MODEL_OPENAI_FAST=gpt-5-mini
LLM_MODEL_OPENAI_STRONG=gpt-5
LLM_MODEL_OPENAI_VISION=gpt-5-mini
PROMPT_VERSION=v1
LLM_MAX_OUTPUT_TOKENS=6000
LLM_MAX_JD_TOKENS=4000
LLM_MAX_RESUME_TOKENS=8000
LLM_REASONING_EFFORT=low
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_CONFIDENCE_HIGH=0.80
JEV_CONFIDENCE_LOW=0.50
LOCAL_STORAGE_DIR=./data/files
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seam
SIGNED_URL_TTL_SECONDS=300

MAX_UPLOAD_MB=5
MAX_PAGES=6
